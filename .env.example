# --- Local dev secrets ---
# Generate at https://aistudio.google.com/apikey. When set, the agent uses
# AI Studio for model calls. When unset, falls back to Vertex AI via ADC.
GOOGLE_API_KEY=

# GCS bucket the agent writes daily digests to (object: YYYY-MM-DD-HHMMSS.md
# in UTC). Must exist and be writable. Locally: writable via your ADC
# (`gcloud auth application-default login`). Deployed: writable by Cloud Run
# service account with `roles/storage.objectCreator`.
DIGEST_BUCKET=

# Discord incoming webhook URL the agent posts the same digest to after the
# GCS write succeeds. Create one in Discord: Channel -> Edit Channel ->
# Integrations -> Webhooks -> New Webhook -> Copy Webhook URL. Format:
# https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=
